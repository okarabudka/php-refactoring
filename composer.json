{
    "name": "okarabudka/php-refactoring",
    "type": "project",
    "description": "Refactoring exercises in PHP: smelly code, characterization tests and the refactored version side by side.",
    "license": "MIT",
    "authors": [
        {
            "name": "Oleksandr Karabudka",
            "email": "sanyakarabudka@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-session": "*",
        "psr/clock": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Okarabudka\\Refactoring\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Okarabudka\\Refactoring\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M --no-progress",
        "cs": "php-cs-fixer check --diff",
        "fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
